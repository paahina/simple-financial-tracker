# Local development only. Production values live in Render (or another host), not here.
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/aurellano-financial-tracker
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
JWT_SECRET=replace-with-a-long-random-string
# How long a login stays valid before the app asks you to sign in again. Examples: 7d, 12h, 30m
JWT_EXPIRES_IN=7d
