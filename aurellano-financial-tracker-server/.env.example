# Local development. On Render, NODE_ENV is production and PORT is assigned by Render.
# Set MONGODB_URI to the Atlas connection string and JWT_SECRET to a long random string.
# ALLOWED_ORIGINS is comma-separated with no spaces. In production, add the Vercel URL.
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/aurellano-financial-tracker
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
